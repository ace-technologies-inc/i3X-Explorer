# Copy to .env (git-ignored) for `npm run dev` / `npm run dev:web`. The real environment wins over this file.
#
# OAuth sign-in profiles: I3X_OAUTH_<NAME>_<FIELD>, where <NAME> is letters and digits. The unnamed form
# I3X_OAUTH_<FIELD> is the profile "default". A profile is offered only for servers under its APPLIES_TO
# URLs; when several apply, the most specific APPLIES_TO match is listed first.
# Fields: LABEL, ISSUER, CLIENT_ID, SCOPES, APPLIES_TO, SERVERS, RESOURCE, EXTRA_PARAMS (query-string form),
# REDIRECT_URI (web), LOOPBACK_REDIRECT_URI (desktop; default http://localhost/, any port unless one is given).
# SCOPES and APPLIES_TO are space- or comma-separated.

I3X_OAUTH_COMPANY_LABEL=Company account
I3X_OAUTH_COMPANY_ISSUER=https://login.example.com/<tenant>/v2.0
I3X_OAUTH_COMPANY_CLIENT_ID=<explorer app registration client ID>
I3X_OAUTH_COMPANY_SCOPES=openid profile offline_access api://<server API>/access_as_user
I3X_OAUTH_COMPANY_APPLIES_TO=http://localhost:5000
I3X_OAUTH_COMPANY_EXTRA_PARAMS=prompt=select_account

# A second profile, for example another tenant or identity provider:
# I3X_OAUTH_PARTNER_ISSUER=https://idp.partner.example
# I3X_OAUTH_PARTNER_CLIENT_ID=
# I3X_OAUTH_PARTNER_SCOPES=
# I3X_OAUTH_PARTNER_APPLIES_TO=
